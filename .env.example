MYSQL_DATABASE=biblioteca
MYSQL_USER=biblioteca_app
MYSQL_PASSWORD=2005
MYSQL_ROOT_PASSWORD=2005
# Modelo TrOCR para leer escritura manuscrita (se descarga en la construcción de la imagen).
TROCR_MODEL=microsoft/trocr-base-handwritten

# Motor OCR: "deepseek" (API de visión) o "trocr" (local).
# Si se deja vacío, se usa DeepSeek cuando hay DEEPSEEK_API_KEY y TrOCR como respaldo.
OCR_ENGINE=deepseek

# API de DeepSeek (formato OpenAI-compatible). Pegá tu clave en DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
