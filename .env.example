MYSQL_DATABASE=biblioteca
MYSQL_USER=biblioteca_app
MYSQL_PASSWORD=2005
MYSQL_ROOT_PASSWORD=2005
# Modelo TrOCR para leer escritura manuscrita (se descarga en la construcción de la imagen).
TROCR_MODEL=microsoft/trocr-base-handwritten

# Motor OCR: "deepseek" (API de visión) o "trocr" (local).
# Si se deja vacío, se usa DeepSeek cuando hay DEEPSEEK_API_KEY y TrOCR como respaldo.
OCR_ENGINE=deepseek

# API de DeepSeek (formato OpenAI-compatible). Pegá tu clave en DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Modelo de visión para el OCR (fichas escaneadas).
DEEPSEEK_MODEL=deepseek-flash
# Modelo de chat para el ChatBot del inventario. `deepseek-chat` es el más económico.
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ChatBot: por defecto usa Google Gemini (endpoint compatible con OpenAI).
# Pegá la clave AIza… en CHATBOT_API_KEY. Si se dejan en blanco, usa DeepSeek
# con las variables DEEPSEEK_* de arriba.
CHATBOT_API_KEY=
# Por defecto: https://generativelanguage.googleapis.com/v1beta/openai
CHATBOT_BASE_URL=
# Por defecto: gemini-2.5-flash
CHATBOT_MODEL=
# Respaldo: si el proveedor principal se queda sin tokens/saldo, el ChatBot
# reintenta con DeepSeek usando DEEPSEEK_API_KEY/DEEPSEEK_CHAT_MODEL.
# Segundos de espera antes de cortar cada llamada al asistente (principal o respaldo).
DEEPSEEK_TIMEOUT=60

# Carpeta con la base de conocimiento institucional (normas, entrevistas).
# Por defecto: ./Entrevistas_Contexto
LIBRARY_CONTEXT_DIR=
